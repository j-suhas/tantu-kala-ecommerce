# Env files (Astro/Vite loads them by mode):
#   .env.production   -> `npm run build`  (committed; prod values)
#   .env.development  -> `npm run dev`     (gitignored; your local/test values)
# Copy this to .env.development and fill in your TEST values. Only PUBLIC_* vars
# are exposed to the built site.

# Order form target (the Apps Script Web App that records orders).
PUBLIC_ORDER_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyMvPmpT5CoFAh_X10Z9Y_zzDcYJL-Lma6Ncp8jyW7CYi3Mfr46Q5XPRptMrPPajVhM/exec

# Canonical site URL (OG images, canonical tags, sitemap). Localhost for dev,
# your live domain for prod.
PUBLIC_SITE_URL=http://localhost:4321
