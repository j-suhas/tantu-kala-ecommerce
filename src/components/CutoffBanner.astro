---
import { SITE } from '../config/site.mjs';

const cutoff = new Date(SITE.orderCutoffISO);
const label = cutoff.toLocaleDateString('en-IN', { day: 'numeric', month: 'long' });

// Advertise the auto-applied order-value coupon (lowest threshold tier).
// Driven by SITE.coupons so the banner never drifts from the actual rule.
const tiers = SITE.coupons?.autoOrderValue ?? [];
const promoTier = tiers.length ? [...tiers].sort((a, b) => a.minSubtotal - b.minSubtotal)[0] : null;
const promo = promoTier
  ? `Extra ${promoTier.percentOff}% OFF orders over ${SITE.currencySymbol}${promoTier.minSubtotal} — auto-applied, no code needed`
  : null;
---

<div id="cutoff-banner" data-cutoff={SITE.orderCutoffISO} class="hidden bg-maroon text-cream text-center text-sm py-2 px-4">
  🪢 Raksha Bandhan is near — order by <strong>{label}</strong> to ship in time<span id="cutoff-days"></span>
</div>

{promo && (
  <div class="bg-saffron text-white text-center text-sm py-1.5 px-4 font-medium">
    🎁 {promo}
  </div>
)}

<script>
  // Hoisted to an external module (CSP-safe — no inline script). Reads the cutoff
  // date from the banner's data attribute; computed per-visitor so it's never stale.
  const banner = document.getElementById('cutoff-banner');
  const daysEl = document.getElementById('cutoff-days');
  if (banner) {
    const cutoffISO = banner.dataset.cutoff;
    const days = Math.ceil((new Date(cutoffISO).getTime() - Date.now()) / 86400000);
    if (days > 0) {
      banner.classList.remove('hidden');
      if (days <= 21 && daysEl) daysEl.textContent = ` · just ${days} day${days === 1 ? '' : 's'} left`;
    }
  }
</script>
