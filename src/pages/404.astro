---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page couldn't be found.">
  <div class="wrap py-20 sm:py-28 text-center max-w-lg">
    <p class="text-saffron font-semibold tracking-wide">404</p>
    <h1 class="mt-2 text-3xl sm:text-4xl">This page knotted itself away</h1>
    <p class="mt-4 text-ink/70">
      We couldn't find that page — it may have moved, or the link isn't quite right.
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/" class="btn-primary">Shop rakhis</a>
      <a href="/contact" class="btn-outline">Contact us</a>
    </div>
  </div>
</Base>
